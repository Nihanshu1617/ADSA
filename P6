#include <iostream>
#include <vector>
#include <algorithm>
#include <iomanip>
using namespace std;

int main() {
    int n;

    cout << "Enter number of files: ";
    cin >> n;

    vector<int> files(n);

    cout << "Enter file sizes: ";
    for (int i = 0; i < n; i++)
        cin >> files[i];

    sort(files.begin(), files.end());

    int time = 0, total = 0;

    for (int size : files) {
        time += size;
        total += time;
    }

    cout << "Files in ascending order: ";

    for (int size : files)
        cout << size << " ";

    cout << "\nMean Retrieval Time (MRT): "
         << fixed << setprecision(2)
         << (double)total / n;

    return 0;
}
